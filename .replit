run = "python3 app.py"
entrypoint = "app.py"
modules = ["python-3.11"]

[nix]
channel = "stable-23_11"
packages = ["xcodebuild", "zlib"]

[[ports]]
localPort = 5000
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "JobBot India"

[[workflows.workflow]]
name = "JobBot India"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 app.py"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
